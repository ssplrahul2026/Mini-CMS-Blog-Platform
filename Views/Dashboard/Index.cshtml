
@model MiniCMS.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="container-fluid py-4">

 

    <div class="dashboard-header mb-5">
        <h2 class="fw-bold">
            <i class="bi bi-speedometer2"></i>
            Admin Dashboard
        </h2>

        <p class="text-muted">
            Welcome to Mini CMS Management Panel
        </p>
    </div>

     @*Total Statistics  *@

    <div class="row g-4 mb-5">

        <div class="col-lg-3 col-md-6">

            <div class="card stat-card bg-primary text-white shadow">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h6>Total Posts</h6>

                            <h2>@Model.TotalPosts</h2>

                        </div>

                        <i class="bi bi-file-earmark-text stat-icon"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card stat-card bg-success text-white shadow">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h6>Categories</h6>

                            <h2>@Model.TotalCategories</h2>

                        </div>

                        <i class="bi bi-folder-fill stat-icon"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card stat-card bg-warning text-dark shadow">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h6>Tags</h6>

                            <h2>@Model.TotalTags</h2>

                        </div>

                        <i class="bi bi-tags-fill stat-icon"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card stat-card bg-danger text-white shadow">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h6>Published</h6>

                            <h2>@Model.PublishedPosts</h2>

                        </div>

                        <i class="bi bi-check-circle-fill stat-icon"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    @* < Draft Card  *@

    <div class="row mb-5">

        <div class="col-md-6">

            <div class="card shadow border-0">

                <div class="card-body">

                    <h5 class="text-secondary">
                        Draft Posts
                    </h5>

                    <h1 class="display-5 fw-bold text-primary">
                        @Model.DraftPosts
                    </h1>

                </div>

            </div>

        </div>

    </div>

    @* Quick Actions  *@

    <h4 class="mb-4 fw-bold">
        Quick Actions
    </h4>

    <div class="row g-4">

        <div class="col-lg-4">

            <div class="card dashboard-card shadow-sm h-100">

                <div class="card-body text-center">

                    <i class="bi bi-file-earmark-text dashboard-icon text-primary"></i>

                    <h4 class="mt-3">
                        Posts
                    </h4>

                    <p class="text-muted">
                        Create, Edit and Delete blog posts.
                    </p>

                    <a asp-controller="Post"
                       asp-action="Index"
                       class="btn btn-primary">

                        Manage Posts

                    </a>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card dashboard-card shadow-sm h-100">

                <div class="card-body text-center">

                    <i class="bi bi-folder-fill dashboard-icon text-success"></i>

                    <h4 class="mt-3">
                        Categories
                    </h4>

                    <p class="text-muted">
                        Organize your blog categories.
                    </p>

                    <a asp-controller="Category"
                       asp-action="Index"
                       class="btn btn-success">

                        Manage Categories

                    </a>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card dashboard-card shadow-sm h-100">

                <div class="card-body text-center">

                    <i class="bi bi-tags-fill dashboard-icon text-warning"></i>

                    <h4 class="mt-3">
                        Tags
                    </h4>

                    <p class="text-muted">
                        Manage blog tags easily.
                    </p>

                    <a asp-controller="Tag"
                       asp-action="Index"
                       class="btn btn-warning">

                        Manage Tags

                    </a>

                </div>

            </div>

        </div>





        <div class="col-lg-4">

            <div class="card dashboard-card shadow-sm h-100">

                <div class="card-body text-center">

                    <i class="bi bi-folder-fill dashboard-icon text-success"></i>

                    <h4 class="mt-3">
                        Comments
                    </h4>

                    <p class="text-muted">
                        Organize your blog Comments.
                    </p>

                    <a asp-controller="Comment"
                       asp-action="Index"
                       class="btn btn-success">

                        Manage Comment

                    </a>

                </div>

            </div>

        </div>





    </div>

</div>