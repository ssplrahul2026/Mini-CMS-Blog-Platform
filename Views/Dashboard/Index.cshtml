
@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="container-fluid py-4">


    <div class="dashboard-header mb-4">

        <h2 class="fw-bold">
            <i class="bi bi-speedometer2"></i>
            Admin Dashboard
        </h2>

        <p class="text-muted">
            Welcome to Mini CMS Management Panel
        </p>

    </div>



    <div class="row g-4">

        <div class="col-lg-4">

            <div class="card dashboard-card shadow-sm">

                <div class="card-body text-center">

                    <i class="bi bi-file-earmark-text dashboard-icon text-primary"></i>

                    <h4 class="mt-3">Posts</h4>

                    <p class="text-muted">
                        Create, Edit and Delete blog posts.
                    </p>

                    <a asp-controller="Post"
                       asp-action="Index"
                       class="btn btn-primary">

                        Manage Posts

                    </a>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card dashboard-card shadow-sm">

                <div class="card-body text-center">

                    <i class="bi bi-folder-fill dashboard-icon text-success"></i>

                    <h4 class="mt-3">Categories</h4>

                    <p class="text-muted">
                        Organize your blog categories.
                    </p>

                    <a asp-controller="Category"
                       asp-action="Index"
                       class="btn btn-success">

                        Manage Categories

                    </a>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card dashboard-card shadow-sm">

                <div class="card-body text-center">

                    <i class="bi bi-tags-fill dashboard-icon text-warning"></i>

                    <h4 class="mt-3">Tags</h4>

                    <p class="text-muted">
                        Manage blog tags easily.
                    </p>

                    <a asp-controller="Tag"
                       asp-action="Index"
                       class="btn btn-warning">

                        Manage Tags

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
