@model IEnumerable<MiniCMS.Models.Entities.Tag>

@{
    ViewData["Title"] = "Tags";
}

<h2 class="mt-3">Tags</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        Create Tag
    </a>
</div>

<table class="table table-bordered table-hover">

    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>Tag Name</th>
            <th width="180">Actions</th>
        </tr>
    </thead>

    <tbody>

        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>

                    <td>@item.TagId</td>

                    <td>@item.Name</td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@item.TagId"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.TagId"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">
                    No Tags Found.
                </td>
            </tr>
        }

    </tbody>

</table>