
@model MiniCMS.Models.Entities.Tag

@{
    ViewData["Title"] = "Create Tag";
}

<div class="container-fluid py-4" style="background:#f4f7fc; min-height:100vh;">



    <div class="mb-4">

        <a asp-action="Index"
           class="btn btn-outline-dark rounded-pill px-4 mb-3">

            <i class="bi bi-arrow-left"></i>
            Back to Tags

        </a>

        <h2 class="fw-bold text-primary mb-1">

            Create Tag

        </h2>

        <p class="text-muted">

            Add a new tag to organize and categorize your blog posts.

        </p>

    </div>

    <form asp-action="Create" method="post">

        <div class="row justify-content-center">

            <div class="col-lg-6">

              

                <div class="card shadow border-0 rounded-4">

                    <div class="card-header bg-primary text-white rounded-top-4">

                        <h5 class="mb-0">

                            <i class="bi bi-tags"></i>
                            Tag Information

                        </h5>

                    </div>

                    <div class="card-body p-4">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">

                                Tag Name

                            </label>

                            <input asp-for="Name"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="Enter tag name" />

                            <span asp-validation-for="Name"
                                  class="text-danger"></span>

                            <small class="text-muted">

                                Examples: ASP.NET Core, MVC, C#, SQL Server, Entity Framework

                            </small>

                        </div>

                    </div>

                </div>

              

                <div class="card shadow border-0 rounded-4 mt-4">

                    <div class="card-body">

                        <div class="d-flex justify-content-end gap-3">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary rounded-pill px-5">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-success rounded-pill px-5">

                                <i class="bi bi-check-circle"></i>
                                Save Tag

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

