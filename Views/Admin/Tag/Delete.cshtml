
@model MiniCMS.Models.Entities.Tag

@{
    ViewData["Title"] = "Delete Tag";
}

<div class="container-fluid py-4" style="background:#f4f7fc; min-height:100vh;">

    

    <div class="mb-4">

        <a asp-action="Index"
           class="btn btn-outline-dark rounded-pill px-4 mb-3">

            <i class="bi bi-arrow-left"></i>
            Back to Tags

        </a>

        <h2 class="fw-bold text-danger mb-1">

            Delete Tag

        </h2>

        <p class="text-muted">

            This action is permanent and cannot be undone.

        </p>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-6">

            
            <div class="card border-0 shadow rounded-4">

                <div class="card-header bg-danger text-white rounded-top-4">

                    <h5 class="mb-0">

                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Delete Confirmation

                    </h5>

                </div>

                <div class="card-body p-4">

                    <div class="alert alert-warning border-0">

                        <h5 class="fw-bold">

                            <i class="bi bi-exclamation-circle-fill"></i>
                            Warning!

                        </h5>

                        <p class="mb-0">

                            You are about to permanently delete this tag.

                        </p>

                    </div>

                  

                    <div class="card bg-light border-0 mt-4">

                        <div class="card-body">

                            <div class="row">

                                <div class="col-4">

                                    <strong>Tag ID</strong>

                                </div>

                                <div class="col-8">

                                    #@Model.TagId

                                </div>

                            </div>

                            <hr />

                            <div class="row">

                                <div class="col-4">

                                    <strong>Tag Name</strong>

                                </div>

                                <div class="col-8">

                                    @Model.Name

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="alert alert-danger mt-4 mb-0">

                        <i class="bi bi-info-circle-fill"></i>

                        Once deleted, this tag cannot be recovered.

                    </div>

                </div>

            </div>

            

            <div class="card border-0 shadow rounded-4 mt-4">

                <div class="card-body">

                    <form asp-action="Delete" method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="TagId" type="hidden" />

                        <div class="d-flex justify-content-end gap-3">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary rounded-pill px-5">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-danger rounded-pill px-5">

                                <i class="bi bi-trash-fill"></i>
                                Delete Tag

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

