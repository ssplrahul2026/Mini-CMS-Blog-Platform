@model IEnumerable<MiniCMS.Models.Entities.Post>

@{
    ViewData["Title"] = "Posts";
}

<h2 class="mt-3">Posts</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        Create Post
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No posts found.
    </div>
}
else
{
    <div class="row">

        @foreach (var post in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card shadow-sm h-100">

                    @if (!string.IsNullOrEmpty(post.CoverImagePath))
                    {
                        <img src="@post.CoverImagePath"
                             class="card-img-top"
                             style="height:220px;object-fit:cover;" />
                    }
                    else
                    {
                        <img src="https://placehold.co/600x350?text=No+Image"
                             class="card-img-top"
                             style="height:220px;object-fit:cover;" />
                    }

                    <div class="card-body">

                        <h4 class="card-title">
                            @post.Title
                        </h4>

                        <p class="mb-1">
                            <strong>Category :</strong>
                            @post.Category?.Name
                        </p>

                        <p class="mb-1">

                            <strong>Status :</strong>

                            @if(post.IsPublished)
                            {
                                <span class="badge bg-success">
                                    Published
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Draft
                                </span>
                            }

                        </p>

                        <p class="mb-3">

                            <strong>Date :</strong>

                            @(post.PublishedDate?.ToString("dd MMM yyyy"))

                        </p>

                        <div>

                            @foreach(var tag in post.PostTags)
                            {
                                <span class="badge bg-info text-dark me-1">
                                    @tag.Tag.Name
                                </span>
                            }

                        </div>

                    </div>

                    <div class="card-footer bg-white">

                        <a asp-action="Edit"
                           asp-route-id="@post.PostId"
                           class="btn btn-warning">
                            Edit
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@post.PostId"
                              method="post"
                              style="display:inline;"
                              onsubmit="return confirm('Are you sure you want to delete this post?');">

                            <button type="submit" class="btn btn-danger">
                                Delete
                            </button>

                        </form>

                    </div>

                </div>

            </div>
        }

    </div>

}