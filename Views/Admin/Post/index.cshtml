
@model IEnumerable<MiniCMS.Models.Entities.Post>

@{
    ViewData["Title"] = "Posts";
}

<div class="container-fluid mt-4">

    @* Header  *@
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-outline-secondary mb-3">
                <i class="bi bi-arrow-left"></i> Back
            </a>

            <h2 class="fw-bold mb-0">
                Posts
            </h2>

            <small class="text-muted">
                Manage all blog posts
            </small>

        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Create Post
        </a>

    </div>



    <form asp-action="Index" method="get">

        <div class="card filter-card border-0 shadow rounded-4 p-4 mb-5">

            <div class="row g-3 align-items-end">

                @*  Search  *@
                <div class="col-lg-3">
                    <input type="text"
                           name="searchTerm"
                           value="@ViewBag.SearchTerm"
                           class="form-control"
                           placeholder="Search by title..." />
                </div>

                 @* Category  *@
                <div class="col-lg-2">
                    <select name="categoryId" class="form-select">
                        <option value="">All Categories</option>

                        @foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.CategoryId"
                                    selected="@(ViewBag.CategoryId?.ToString() == category.CategoryId.ToString())">
                                @category.Name
                            </option>
                        }
                    </select>
                </div>

                 @* Tag  *@
                <div class="col-lg-2">
                    <select name="tagId" class="form-select">
                        <option value="">All Tags</option>

                        @foreach (var tag in ViewBag.Tags)
                        {
                            <option value="@tag.TagId"
                                    selected="@(ViewBag.TagId?.ToString() == tag.TagId.ToString())">
                                @tag.Name
                            </option>
                        }
                    </select>
                </div>

               @* Sort  *@
                <div class="col-lg-2">
                    <select name="sortBy" class="form-select">
                        <option value="">Newest First</option>
                        <option value="oldest" selected="@(ViewBag.SortBy == "oldest")">Oldest First</option>
                        <option value="title" selected="@(ViewBag.SortBy == "title")">Title (A-Z)</option>
                        <option value="title_desc" selected="@(ViewBag.SortBy == "title_desc")">Title (Z-A)</option>
                    </select>
                </div>

                @* Filter  *@
                <div class="col-lg-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-3">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                </div>

                 @* Reset  *@
                <div class="col-lg-1">
                    <a asp-action="Index"
                       class="btn btn-secondary w-100 rounded-3">
                        Reset
                    </a>
                </div>

            </div>

        </div>

    </form>



    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            No posts found.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var post in Model)
            {
                <div class="col-lg-4 col-md-6">

                    <div class="card border-0 shadow-sm h-100">

                        @*  Image  *@
                        @if (!string.IsNullOrEmpty(post.CoverImagePath))
                        {
                            <img src="@post.CoverImagePath"
                                 class="card-img-top"
                                 style="height:220px;object-fit:cover;">
                        }
                        else
                        {
                            <img src="https://placehold.co/600x350?text=No+Image"
                                 class="card-img-top"
                                 style="height:220px;object-fit:cover;">
                        }

                        @*  Body  *@

                        <div class="card-body d-flex flex-column">

                            <h5 class="fw-bold mb-3">
                                @post.Title
                            </h5>

                            <table class="table table-borderless table-sm mb-3">

                                <tr>
                                    <th width="90">Category</th>
                                    <td>@post.Category?.Name</td>
                                </tr>

                                <tr>
                                    <th>Status</th>

                                    <td>

                                        @if (post.IsPublished)
                                        {
                                            <span class="badge bg-success px-3">
                                                Published
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3">
                                                Draft
                                            </span>
                                        }

                                    </td>

                                </tr>

                                <tr>
                                    <th>Date</th>

                                    <td>

                                        @(post.PublishedDate?.ToString("dd MMM yyyy") ?? "-")

                                    </td>

                                </tr>

                            </table>

                            <div class="mb-3">

                                <strong class="d-block mb-2">
                                    Tags
                                </strong>

                                @if (post.PostTags.Any())
                                {
                                    @foreach (var tag in post.PostTags)
                                    {
                                        <span class="badge bg-light text-dark border me-1 mb-1">
                                            @tag.Tag.Name
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No Tags
                                    </span>
                                }

                            </div>

                            <div class="mt-auto">

                                <div class="d-grid gap-2">

                                    <a asp-action="Edit"
                                       asp-route-id="@post.PostId"
                                       class="btn btn-warning">

                                        <i class="bi bi-pencil-square"></i>
                                        Edit

                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@post.PostId"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this post?');">

                                        <button class="btn btn-danger w-100">

                                            <i class="bi bi-trash"></i>
                                            Delete

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>