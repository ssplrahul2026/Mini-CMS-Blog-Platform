@model MiniCMS.Models.ViewModels.PostViewModel

@{
    ViewData["Title"] = "Edit Post";
}
<style>

    body {
        background: #eef2f7;
        font-family: Segoe UI,Arial,sans-serif;
    }

    .edit-container {
        max-width: 1000px;
        margin: 35px auto;
        padding: 0 15px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .page-header h2 {
            margin: 0;
            font-size: 28px;
            color: #2c3e50;
        }

        .page-header p {
            margin-top: 5px;
            color: #777;
        }

    .btn-back {
        background: #ffffff;
        border: 1px solid #dcdcdc;
        color: #333;
        padding: 10px 18px;
        text-decoration: none;
        border-radius: 6px;
    }

        .btn-back:hover {
            background: #f3f3f3;
        }

    .form-box {
        background: #ffffff;
        padding: 30px;
        border-radius: 8px;
        border: 1px solid #ddd;
    }

    .form-group {
        margin-bottom: 22px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #444;
        }

    .form-control {
        width: 100%;
        padding: 11px;
        border: 1px solid #ced4da;
        border-radius: 6px;
        box-sizing: border-box;
    }

    textarea {
        resize: vertical;
    }

    .row-box {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
    }

    .publish-box {
        height: 45px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .image-box {
        border: 1px solid #ddd;
        padding: 10px;
        display: inline-block;
        border-radius: 6px;
        background: #fafafa;
    }

        .image-box img {
            width: 220px;
            max-width: 100%;
            border-radius: 4px;
        }

    .button-group {
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        margin-top: 30px;
    }

    .btn-save {
        background: #2563eb;
        color: #fff;
        border: none;
        padding: 11px 24px;
        border-radius: 6px;
        cursor: pointer;
    }

        .btn-save:hover {
            background: #1d4ed8;
        }

    .btn-cancel {
        background: #6c757d;
        color: #fff;
        padding: 11px 24px;
        border-radius: 6px;
        text-decoration: none;
    }

        .btn-cancel:hover {
            background: #5a6268;
        }

    .validation-summary {
        color: red;
        margin-bottom: 20px;
    }

    .text-danger {
        color: red;
        font-size: 14px;
    }

    @@media (max-width:768px) {

        .row-box {
            grid-template-columns: 1fr;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .button-group {
            justify-content: flex-start;
        }
    }

</style>
<div class="edit-container">

    <div class="page-header">
        <div>
            <h2>Edit Post</h2>
            <p>Update your blog post information.</p>
        </div>

        <a asp-action="Index" class="btn-back">
             Back
        </a>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">

        <input asp-for="PostId" type="hidden" />
        <input asp-for="ExistingImagePath" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-box">

            <div class="form-group">
                <label asp-for="Title"></label>

                <input asp-for="Title" class="form-control" />

                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Slug"></label>

                <input asp-for="Slug" class="form-control" />

                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="row-box">

                <div class="form-group">
                    <label asp-for="CategoryId">Category</label>

                    <select asp-for="CategoryId"
                            asp-items="Model.Categories"
                            class="form-control">

                        <option value="">Select Category</option>

                    </select>

                    <span asp-validation-for="CategoryId" class="text-danger"></span>

                </div>

                <div class="form-group">

                    <label>Publish</label>

                    <div class="publish-box">

                        <input asp-for="IsPublished" />

                        <label asp-for="IsPublished">
                            Published
                        </label>

                    </div>

                </div>

            </div>

            <div class="form-group">

                <label>Tags</label>

                <select asp-for="SelectedTags"
                        asp-items="Model.Tags"
                        class="form-control select2"
                        multiple>
                </select>

            </div>

            <div class="form-group">

                <label>Replace Cover Image</label>

                <input asp-for="CoverImage"
                       type="file"
                       class="form-control" />

                <span asp-validation-for="CoverImage"
                      class="text-danger"></span>

            </div>

            @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
            {
                <div class="form-group">

                    <label>Current Cover Image</label>

                    <div class="image-box">

                        <img src="@Model.ExistingImagePath"
                             alt="Cover Image" />

                    </div>

                </div>
            }

            <div class="form-group">

                <label asp-for="Body"></label>

                <textarea asp-for="Body"
                          rows="14"
                          class="form-control"></textarea>

                <span asp-validation-for="Body"
                      class="text-danger"></span>

            </div>

            <div class="button-group">

                <a asp-action="Index"
                   class="btn-cancel">

                    Cancel

                </a>

                <button type="submit"
                        class="btn-save">

                    Update Post

                </button>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        $(function () {

            $('.select2').select2({

                placeholder: "Select Tags",

                width: "100%"

            });

        });

    </script>

}

