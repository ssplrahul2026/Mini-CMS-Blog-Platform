@model MiniCMS.Models.ViewModels.PostViewModel

@{
    ViewData["Title"] = "Edit Post";
}

<div class="container-fluid py-4" style="background:#f4f7fc; min-height:100vh;">

   
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <a asp-action="Index"
               class="btn btn-outline-dark rounded-pill px-4 mb-3">

                <i class="bi bi-arrow-left"></i>
                Back to Posts

            </a>

            <h2 class="fw-bold text-warning mb-1">
                Edit Post
            </h2>

            <p class="text-muted">
                Update the post information and save your changes.
            </p>

        </div>

    </div>

    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        <input asp-for="PostId" type="hidden" />
        <input asp-for="ExistingImagePath" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="row">

            @*  LEFT SIDE  *@

            <div class="col-lg-8">

                <div class="card shadow border-0 rounded-4 mb-4">

                    <div class="card-header bg-warning text-dark rounded-top-4">

                        <h5 class="mb-0">
                            <i class="bi bi-file-earmark-text"></i>
                            Post Content
                        </h5>

                    </div>

                    <div class="card-body">

                        @*  Title  *@

                        <div class="mb-4">

                            <label asp-for="Title"
                                   class="form-label fw-semibold"></label>

                            <input asp-for="Title"
                                   class="form-control form-control-lg"
                                   placeholder="Enter post title" />

                            <span asp-validation-for="Title"
                                  class="text-danger"></span>

                        </div>

                        @* <Slug  *@

                        <div class="mb-4">

                            <label asp-for="Slug"
                                   class="form-label fw-semibold"></label>

                            <input asp-for="Slug"
                                   class="form-control"
                                   placeholder="Enter post slug" />

                            <span asp-validation-for="Slug"
                                  class="text-danger"></span>

                        </div>

                        @* Body  *@

                        <div>

                            <label asp-for="Body"
                                   class="form-label fw-semibold"></label>

                            <textarea asp-for="Body"
                                      rows="15"
                                      class="form-control"
                                      placeholder="Write your content here..."></textarea>

                            <span asp-validation-for="Body"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

            </div>

            @* RIGHT SIDE  *@

            <div class="col-lg-4">

                @* Publish  *@

                <div class="card shadow border-0 rounded-4 mb-4">

                    <div class="card-header bg-warning text-dark rounded-top-4">

                        <h5 class="mb-0">

                            <i class="bi bi-upload"></i>
                            Publish

                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="form-check form-switch">

                            <input asp-for="IsPublished"
                                   class="form-check-input" />

                            <label asp-for="IsPublished"
                                   class="form-check-label ms-2">

                                Published

                            </label>

                        </div>

                    </div>

                </div>

                @*  Category  *@

                <div class="card shadow border-0 rounded-4 mb-4">

                    <div class="card-header bg-warning text-dark rounded-top-4">

                        <h5 class="mb-0">

                            <i class="bi bi-folder"></i>
                            Category

                        </h5>

                    </div>

                    <div class="card-body">

                        <select asp-for="CategoryId"
                                asp-items="Model.Categories"
                                class="form-select">

                            <option value="">
                                Select Category
                            </option>

                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger"></span>

                    </div>

                </div>

                @*  Tags  *@

                <div class="card shadow border-0 rounded-4 mb-4">

                    <div class="card-header bg-warning text-dark rounded-top-4">

                        <h5 class="mb-0">

                            <i class="bi bi-tags"></i>
                            Tags

                        </h5>

                    </div>

                    <div class="card-body">

                        <select asp-for="SelectedTags"
                                asp-items="Model.Tags"
                                class="form-select select2"
                                multiple>
                        </select>

                    </div>

                </div>

                @*  Current Image  *@
                @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                {
                    <div class="card shadow border-0 rounded-4 mb-4">

                        <div class="card-header bg-warning text-dark rounded-top-4">

                            <h5 class="mb-0">

                                <i class="bi bi-image"></i>
                                Current Cover Image

                            </h5>

                        </div>

                        <div class="card-body text-center">

                            <img src="@Model.ExistingImagePath"
                                 class="img-fluid rounded shadow-sm"
                                 style="max-height:220px;" />

                        </div>

                    </div>
                }

                @*  Upload  *@

                <div class="card shadow border-0 rounded-4">

                    <div class="card-header bg-warning text-dark rounded-top-4">

                        <h5 class="mb-0">

                            <i class="bi bi-cloud-upload"></i>
                            Replace Cover Image

                        </h5>

                    </div>

                    <div class="card-body">

                        <input asp-for="CoverImage"
                               type="file"
                               class="form-control" />

                        <span asp-validation-for="CoverImage"
                              class="text-danger"></span>

                    </div>

                </div>

            </div>

        </div>

        @*  Bottom Buttons  *@

        <div class="card shadow border-0 rounded-4 mt-4">

            <div class="card-body">

                <div class="d-flex justify-content-end gap-3">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary rounded-pill px-5">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-warning rounded-pill px-5">

                        <i class="bi bi-pencil-square"></i>
                        Update Post

                    </button>

                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {

            $('.select2').select2({
                placeholder: "Select Tags",
                allowClear: true,
                width: "100%"
            });

        });
    </script>
}