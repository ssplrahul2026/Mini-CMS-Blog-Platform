@model MiniCMS.Models.ViewModels.PostViewModel

@{
    ViewData["Title"] = "Edit Post";
}

<h2 class="mt-3">Edit Post</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">

    <input asp-for="PostId" type="hidden" />
    <input asp-for="ExistingImagePath" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    
    <div class="mb-3">

        <label asp-for="Title" class="form-label">
            Title
        </label>

        <input asp-for="Title"
               class="form-control"
               placeholder="Enter post title" />

        <span asp-validation-for="Title"
              class="text-danger"></span>

    </div>

   
    <div class="mb-3">

        <label asp-for="Slug" class="form-label">
            Slug
        </label>

        <input asp-for="Slug"
               class="form-control"
               placeholder="Enter post slug" />

        <span asp-validation-for="Slug"
              class="text-danger"></span>

    </div>

    
    <div class="mb-3">

        <label asp-for="Body" class="form-label">
            Content
        </label>

        <textarea asp-for="Body"
                  rows="6"
                  class="form-control"
                  placeholder="Write your post here..."></textarea>

        <span asp-validation-for="Body"
              class="text-danger"></span>

    </div>

    @* Category *@
    <div class="mb-3">

        <label asp-for="CategoryId" class="form-label">
            Category
        </label>

        <select asp-for="CategoryId"
                asp-items="Model.Categories"
                class="form-select">

            <option value="">-- Select Category --</option>

        </select>

        <span asp-validation-for="CategoryId"
              class="text-danger"></span>

    </div>

    @* Tags  *@
    <div class="mb-3">

        <label class="form-label">
            Tags
        </label>

        <select asp-for="SelectedTags"
                asp-items="Model.Tags"
                class="form-select"
                multiple>
        </select>

        <small class="text-muted">
            Hold Ctrl to select multiple tags.
        </small>

    </div>

     @* Current Image *@
    @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
    {
        <div class="mb-3">

            <label class="form-label">
                Current Cover Image
            </label>

            <br />

            <img src="@Model.ExistingImagePath"
                 class="img-thumbnail"
                 width="200" />

        </div>
    }

    @* Upload New Image  *@
    <div class="mb-3">

        <label asp-for="CoverImage" class="form-label">
            Upload New Image
        </label>

        <input asp-for="CoverImage"
               type="file"
               class="form-control" />

        <span asp-validation-for="CoverImage"
              class="text-danger"></span>

    </div>

    
    <div class="form-check mb-3">

        <input asp-for="IsPublished"
               class="form-check-input" />

        <label asp-for="IsPublished"
               class="form-check-label">
            Publish Post
        </label>

    </div>

    <button type="submit" class="btn btn-warning">
        Update
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>

