@model IEnumerable<MiniCMS.Models.Entities.Post>

@{
    ViewData["Title"] = "Deleted Posts";
}

<div class="container-fluid py-4" style="background:#f4f7fc; min-height:100vh;">

 @* Header  *@
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-danger mb-1">
                Deleted Posts
            </h2>

            <p class="text-muted mb-0">
                Restore soft deleted posts.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-dark rounded-pill px-4">

            <i class="bi bi-arrow-left"></i>
            Back to Posts

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow border-0 rounded-4">

            <div class="card-body text-center py-5">

                <i class="bi bi-trash display-1 text-secondary"></i>

                <h4 class="mt-3">
                    No Deleted Posts
                </h4>

                <p class="text-muted">
                    There are no deleted posts available.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="row">

            @foreach (var post in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">

                    <div class="card border-0 shadow-sm rounded-4 h-100">

                        @if (!string.IsNullOrEmpty(post.CoverImagePath))
                        {
                            <img src="@post.CoverImagePath"
                                 class="card-img-top"
                                 style="height:220px;object-fit:cover;" />
                        }
                        else
                        {
                            <img src="~/images/no-image.png"
                                 class="card-img-top"
                                 style="height:220px;object-fit:cover;" />
                        }

                        <div class="card-body">

                            <h5 class="fw-bold">
                                @post.Title
                            </h5>

                            <hr />

                            <table class="table table-borderless table-sm">

                                <tr>
                                    <th>Category</th>
                                    <td>@post.Category?.Name</td>
                                </tr>

                                <tr>
                                    <th>Status</th>
                                    <td>
                                        @if (post.IsPublished)
                                        {
                                            <span class="badge bg-success">
                                                Published
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Draft
                                            </span>
                                        }
                                    </td>
                                </tr>

                                <tr>
                                    <th>Date</th>
                                    <td>
                                        @post.PublishedDate?.ToString("dd MMM yyyy")
                                    </td>
                                </tr>

                            </table>

                        </div>

                        <div class="card-footer bg-white border-0">

                            <form asp-action="Restore"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@post.PostId" />

                                <button type="submit"
                                        class="btn btn-success w-100 rounded-pill">

                                    <i class="bi bi-arrow-counterclockwise"></i>

                                    Restore Post

                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>