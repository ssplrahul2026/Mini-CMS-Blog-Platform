
@model IEnumerable<MiniCMS.Models.Entities.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="container-fluid py-4" style="background:#f4f7fc; min-height:100vh;">


    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-outline-dark rounded-pill px-4 mb-3">

                <i class="bi bi-arrow-left"></i>
                Back to Dashboard

            </a>

            <h2 class="fw-bold text-primary mb-1">

                Category Management

            </h2>

            <p class="text-muted mb-0">

                Create, update and organize your blog categories.

            </p>

        </div>

        <div class="text-end">

            <span class="badge bg-primary fs-6 px-4 py-2 rounded-pill mb-2">

                Total Categories : @Model.Count()

            </span>

            <br />

            <a asp-action="Create"
               class="btn btn-primary rounded-pill px-4 mt-2">

                <i class="bi bi-plus-circle"></i>
                Create Category

            </a>

        </div>

    </div>



    <div class="card border-0 shadow rounded-4">

        <div class="card-header bg-primary text-white rounded-top-4 py-3">

            <h5 class="mb-0">

                <i class="bi bi-folder2-open"></i>
                Categories

            </h5>

        </div>

        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th width="90">
                                    ID
                                </th>

                                <th>
                                    Category Name
                                </th>

                                <th width="220" class="text-center">

                                    Actions

                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>

                                        <strong>#@item.CategoryId</strong>

                                    </td>

                                    <td>

                                        <span class="fw-semibold">

                                            @item.Name

                                        </span>

                                    </td>

                                    <td class="text-center">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.CategoryId"
                                           class="btn btn-warning btn-sm rounded-pill me-2">

                                            <i class="bi bi-pencil-square"></i>
                                            Edit

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.CategoryId"
                                           class="btn btn-danger">
                                            Delete
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-folder-x display-1 text-muted"></i>

                    <h4 class="mt-3 text-muted">

                        No Categories Found

                    </h4>

                    <p class="text-muted">

                        Click <strong>Create Category</strong> to add your first category.

                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary rounded-pill px-4">

                        <i class="bi bi-plus-circle"></i>
                        Create Category

                    </a>

                </div>
            }

        </div>

    </div>

</div>