
@model MiniCMS.Models.Entities.Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container-fluid py-4" style="background:#f4f7fc; min-height:100vh;">

    
    <div class="mb-4">

        <a asp-action="Index"
           class="btn btn-outline-dark rounded-pill px-4 mb-3">

            <i class="bi bi-arrow-left"></i>
            Back to Categories

        </a>

        <h2 class="fw-bold text-warning mb-1">

            Edit Category

        </h2>

        <p class="text-muted">

            Update the category details below.

        </p>

    </div>

    <form asp-action="Edit" method="post">

        <input asp-for="CategoryId" type="hidden" />

        <div class="row justify-content-center">

            <div class="col-lg-6">

                <div class="card shadow border-0 rounded-4">

                    <div class="card-header bg-warning text-dark rounded-top-4">

                        <h5 class="mb-0">

                            <i class="bi bi-pencil-square"></i>
                            Category Information

                        </h5>

                    </div>

                    <div class="card-body p-4">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">

                                Category Name

                            </label>

                            <input asp-for="Name"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="Enter category name" />

                            <span asp-validation-for="Name"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

               

                <div class="card shadow border-0 rounded-4 mt-4">

                    <div class="card-body">

                        <div class="d-flex justify-content-end gap-3">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary rounded-pill px-5">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-warning rounded-pill px-5">

                                <i class="bi bi-pencil-square"></i>
                                Update Category

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

